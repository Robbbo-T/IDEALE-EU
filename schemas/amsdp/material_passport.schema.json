{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideale-eu.org/schemas/amsdp/material_passport.schema.json",
  "title": "Material Passport Schema",
  "description": "Digital passport for aerospace materials and components",
  "type": "object",
  "required": ["passport", "version"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version (semantic versioning)"
    },
    "passport": {
      "type": "object",
      "required": ["id", "type", "classification", "identity", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AMSDP-MATERIAL-[A-Z0-9]+-v\\d+$",
          "description": "Unique passport identifier"
        },
        "type": {
          "type": "string",
          "enum": ["MATERIAL", "ASSEMBLY", "PRIMARY_STRUCTURE", "SECONDARY_STRUCTURE", "INSTALLATION_HARDWARE", "INFORMATION_HARDWARE", "ANTENNA", "SENSOR", "SOFTWARE_LICENSE", "FIRMWARE_LICENSE", "SLA", "ENGINEERING_MODEL", "PRETRAINED_MODEL"],
          "description": "Passport type"
        },
        "component_category": {
          "type": "string",
          "enum": [
            "PRIMARY_STRUCTURE",
            "SECONDARY_STRUCTURE", 
            "INSTALLATION_HARDWARE",
            "INFORMATION_HARDWARE",
            "ANTENNA",
            "SENSOR",
            "SOFTWARE_LICENSE",
            "FIRMWARE_LICENSE",
            "SLA",
            "ENGINEERING_MODEL",
            "PRETRAINED_MODEL",
            "RAW_MATERIAL",
            "COMPONENT",
            "ASSEMBLY"
          ],
          "description": "Detailed component category classification"
        },
        "classification": {
          "type": "string",
          "enum": ["PUBLIC", "RESTRICTED", "CONTROLLED"],
          "description": "Data classification level"
        },
        "identity": {
          "type": "object",
          "required": ["part_number", "serial_number", "manufacturer"],
          "properties": {
            "part_number": {
              "type": "string",
              "description": "Manufacturer part number"
            },
            "serial_number": {
              "type": "string",
              "description": "Unique serial number"
            },
            "manufacturer": {
              "type": "string",
              "description": "Manufacturer name"
            },
            "batch_lot": {
              "type": "string",
              "description": "Batch or lot number"
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["origin"],
          "properties": {
            "origin": {
              "type": "object",
              "required": ["country", "facility"],
              "properties": {
                "country": {
                  "type": "string",
                  "description": "Country of origin (ISO 3166-1 alpha-2)"
                },
                "facility": {
                  "type": "string",
                  "description": "Manufacturing facility"
                },
                "certification": {
                  "type": "string",
                  "description": "Facility certification"
                }
              }
            },
            "supply_chain": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["supplier", "date"],
                "properties": {
                  "supplier": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "certificate": {
                    "type": "string"
                  }
                }
              }
            },
            "certificates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "number", "issuer"],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "number": {
                    "type": "string"
                  },
                  "issuer": {
                    "type": "string"
                  },
                  "expiry": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "material_properties": {
          "type": "object",
          "properties": {
            "specification": {
              "type": "string",
              "description": "Material specification (e.g., AMS, ASTM)"
            },
            "composition": {
              "type": "object",
              "properties": {
                "elements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "percentages": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "mechanical": {
              "type": "object",
              "properties": {
                "tensile": {
                  "type": "number",
                  "description": "Tensile strength (MPa)"
                },
                "yield": {
                  "type": "number",
                  "description": "Yield strength (MPa)"
                },
                "hardness": {
                  "type": "string",
                  "description": "Hardness value and scale"
                }
              }
            },
            "environmental": {
              "type": "object",
              "properties": {
                "temp_min": {
                  "type": "number",
                  "description": "Minimum operating temperature (°C)"
                },
                "temp_max": {
                  "type": "number",
                  "description": "Maximum operating temperature (°C)"
                },
                "corrosion": {
                  "type": "string",
                  "description": "Corrosion resistance rating"
                }
              }
            }
          }
        },
        "component_specific": {
          "type": "object",
          "description": "Component-specific properties based on component_category",
          "properties": {
            "structure": {
              "type": "object",
              "description": "Properties for PRIMARY_STRUCTURE and SECONDARY_STRUCTURE",
              "properties": {
                "structural_type": {
                  "type": "string",
                  "enum": ["FUSELAGE", "WING", "TAIL", "FRAME", "SKIN", "BULKHEAD", "STRINGER", "RIB", "SPAR"]
                },
                "load_rating": {
                  "type": "object",
                  "properties": {
                    "ultimate_load": {"type": "number"},
                    "limit_load": {"type": "number"},
                    "unit": {"type": "string"}
                  }
                },
                "stress_analysis": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "hardware": {
              "type": "object",
              "description": "Properties for INSTALLATION_HARDWARE",
              "properties": {
                "hardware_type": {
                  "type": "string",
                  "enum": ["FASTENER", "BOLT", "NUT", "WASHER", "RIVET", "PIN", "CLAMP", "BRACKET", "HINGE"]
                },
                "torque_spec": {
                  "type": "object",
                  "properties": {
                    "value": {"type": "number"},
                    "unit": {"type": "string"},
                    "tolerance": {"type": "string"}
                  }
                },
                "installation_procedure": {
                  "type": "string"
                }
              }
            },
            "information_hardware": {
              "type": "object",
              "description": "Properties for INFORMATION_HARDWARE",
              "properties": {
                "device_type": {
                  "type": "string",
                  "enum": ["COMPUTER", "PROCESSOR", "MEMORY", "STORAGE", "DISPLAY", "INTERFACE", "NETWORK"]
                },
                "specifications": {
                  "type": "object",
                  "properties": {
                    "processor": {"type": "string"},
                    "memory_gb": {"type": "number"},
                    "storage_gb": {"type": "number"},
                    "interfaces": {"type": "array", "items": {"type": "string"}}
                  }
                },
                "firmware_version": {
                  "type": "string"
                },
                "security_certifications": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            },
            "antenna": {
              "type": "object",
              "description": "Properties for ANTENNA",
              "properties": {
                "antenna_type": {
                  "type": "string",
                  "enum": ["VHF", "UHF", "SATCOM", "GPS", "GNSS", "RADAR", "DATALINK", "WIFI", "5G"]
                },
                "frequency_range": {
                  "type": "object",
                  "properties": {
                    "min_mhz": {"type": "number"},
                    "max_mhz": {"type": "number"}
                  }
                },
                "gain_dbi": {
                  "type": "number"
                },
                "polarization": {
                  "type": "string",
                  "enum": ["LINEAR", "CIRCULAR", "DUAL"]
                },
                "mounting_location": {
                  "type": "string"
                }
              }
            },
            "sensor": {
              "type": "object",
              "description": "Properties for SENSOR",
              "properties": {
                "sensor_type": {
                  "type": "string",
                  "enum": ["TEMPERATURE", "PRESSURE", "ACCELEROMETER", "GYROSCOPE", "MAGNETOMETER", "GPS", "RADAR", "LIDAR", "CAMERA", "MICROPHONE", "VIBRATION", "STRAIN", "FLOW"]
                },
                "measurement_range": {
                  "type": "object",
                  "properties": {
                    "min": {"type": "number"},
                    "max": {"type": "number"},
                    "unit": {"type": "string"}
                  }
                },
                "accuracy": {
                  "type": "string"
                },
                "sampling_rate_hz": {
                  "type": "number"
                },
                "calibration": {
                  "type": "object",
                  "properties": {
                    "last_calibrated": {"type": "string", "format": "date"},
                    "next_due": {"type": "string", "format": "date"},
                    "certificate": {"type": "string"}
                  }
                }
              }
            },
            "software_license": {
              "type": "object",
              "description": "Properties for SOFTWARE_LICENSE",
              "properties": {
                "license_type": {
                  "type": "string",
                  "enum": ["PROPRIETARY", "OPEN_SOURCE", "COMMERCIAL", "SUBSCRIPTION", "PERPETUAL", "TRIAL"]
                },
                "license_key": {
                  "type": "string"
                },
                "licensed_to": {
                  "type": "string"
                },
                "seats": {
                  "type": "integer"
                },
                "expiry_date": {
                  "type": "string",
                  "format": "date"
                },
                "renewal_terms": {
                  "type": "string"
                },
                "software_name": {
                  "type": "string"
                },
                "version_covered": {
                  "type": "string"
                },
                "support_level": {
                  "type": "string",
                  "enum": ["BASIC", "STANDARD", "PREMIUM", "ENTERPRISE"]
                }
              }
            },
            "firmware_license": {
              "type": "object",
              "description": "Properties for FIRMWARE_LICENSE",
              "properties": {
                "firmware_name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "license_type": {
                  "type": "string",
                  "enum": ["PROPRIETARY", "OPEN_SOURCE", "EMBEDDED", "OEM"]
                },
                "device_binding": {
                  "type": "string",
                  "description": "Device or hardware this firmware is bound to"
                },
                "update_policy": {
                  "type": "string"
                },
                "cryptographic_signature": {
                  "type": "string"
                }
              }
            },
            "sla": {
              "type": "object",
              "description": "Properties for SLA (Service Level Agreement)",
              "properties": {
                "service_name": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "agreement_number": {
                  "type": "string"
                },
                "start_date": {
                  "type": "string",
                  "format": "date"
                },
                "end_date": {
                  "type": "string",
                  "format": "date"
                },
                "service_levels": {
                  "type": "object",
                  "properties": {
                    "availability_percent": {"type": "number"},
                    "response_time_hours": {"type": "number"},
                    "resolution_time_hours": {"type": "number"},
                    "support_hours": {"type": "string"}
                  }
                },
                "penalties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "condition": {"type": "string"},
                      "penalty": {"type": "string"}
                    }
                  }
                },
                "renewal_terms": {
                  "type": "string"
                }
              }
            },
            "engineering_model": {
              "type": "object",
              "description": "Properties for ENGINEERING_MODEL",
              "properties": {
                "model_type": {
                  "type": "string",
                  "enum": ["CAD", "CAE", "CFD", "FEA", "SIMULATION", "DIGITAL_TWIN", "MATHEMATICAL"]
                },
                "software_tool": {
                  "type": "string"
                },
                "model_version": {
                  "type": "string"
                },
                "validation_status": {
                  "type": "string",
                  "enum": ["DRAFT", "VALIDATED", "VERIFIED", "CERTIFIED"]
                },
                "validation_report": {
                  "type": "string",
                  "format": "uri"
                },
                "input_parameters": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "output_parameters": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "accuracy_metrics": {
                  "type": "object"
                },
                "limitations": {
                  "type": "string"
                }
              }
            },
            "pretrained_model": {
              "type": "object",
              "description": "Properties for PRETRAINED_MODEL (LLM and AI agent models)",
              "properties": {
                "model_name": {
                  "type": "string"
                },
                "model_type": {
                  "type": "string",
                  "enum": ["LLM", "VISION", "AUDIO", "MULTIMODAL", "AGENT", "REINFORCEMENT_LEARNING", "SUPERVISED", "UNSUPERVISED"]
                },
                "architecture": {
                  "type": "string",
                  "description": "Model architecture (e.g., Transformer, CNN, RNN)"
                },
                "parameters_count": {
                  "type": "string",
                  "description": "Number of parameters (e.g., 7B, 13B, 70B)"
                },
                "training_data": {
                  "type": "object",
                  "properties": {
                    "dataset_name": {"type": "string"},
                    "data_cutoff_date": {"type": "string", "format": "date"},
                    "languages": {"type": "array", "items": {"type": "string"}},
                    "domains": {"type": "array", "items": {"type": "string"}}
                  }
                },
                "performance_metrics": {
                  "type": "object",
                  "description": "Benchmark results and performance metrics"
                },
                "license": {
                  "type": "string"
                },
                "ethical_considerations": {
                  "type": "object",
                  "properties": {
                    "bias_assessment": {"type": "string"},
                    "safety_measures": {"type": "array", "items": {"type": "string"}},
                    "intended_use": {"type": "string"},
                    "limitations": {"type": "string"}
                  }
                },
                "deployment_requirements": {
                  "type": "object",
                  "properties": {
                    "memory_gb": {"type": "number"},
                    "compute_type": {"type": "string"},
                    "framework": {"type": "string"},
                    "runtime_environment": {"type": "string"}
                  }
                },
                "quantization": {
                  "type": "string",
                  "description": "Quantization level if applicable (e.g., FP16, INT8, INT4)"
                },
                "fine_tuning_history": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {"type": "string", "format": "date"},
                      "dataset": {"type": "string"},
                      "purpose": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        },
        "quality_records": {
          "type": "object",
          "properties": {
            "inspection_reports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date", "inspector", "result"],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "inspector": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": ["PASS", "FAIL", "CONDITIONAL"]
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            },
            "test_results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "date", "pass_fail"],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "values": {
                    "type": "object"
                  },
                  "pass_fail": {
                    "type": "string",
                    "enum": ["PASS", "FAIL"]
                  }
                }
              }
            },
            "certifications": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["standard", "number", "date", "issuer"],
                "properties": {
                  "standard": {
                    "type": "string"
                  },
                  "number": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "issuer": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "manufactured": {
              "type": "object",
              "required": ["date", "facility"],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "facility": {
                  "type": "string"
                },
                "operator": {
                  "type": "string"
                }
              }
            },
            "received": {
              "type": "object",
              "required": ["date", "inspector", "condition"],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "inspector": {
                  "type": "string"
                },
                "condition": {
                  "type": "string",
                  "enum": ["ACCEPTABLE", "DAMAGED", "REJECTED"]
                }
              }
            },
            "installed": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "location": {
                  "type": "string"
                },
                "technician": {
                  "type": "string"
                },
                "asset_id": {
                  "type": "string",
                  "description": "Reference to AAMMPP asset"
                }
              }
            },
            "maintenance": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date", "type", "technician"],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "type": {
                    "type": "string"
                  },
                  "technician": {
                    "type": "string"
                  },
                  "findings": {
                    "type": "string"
                  },
                  "actions": {
                    "type": "string"
                  }
                }
              }
            },
            "removed": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "technician": {
                  "type": "string"
                }
              }
            },
            "disposition": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "method": {
                  "type": "string",
                  "enum": ["RECYCLED", "DISPOSED", "RETURNED", "SCRAPPED"]
                },
                "documentation": {
                  "type": "string"
                }
              }
            }
          }
        },
        "compliance": {
          "type": "object",
          "properties": {
            "reach": {
              "type": "object",
              "required": ["compliant"],
              "properties": {
                "compliant": {
                  "type": "boolean"
                },
                "substances": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "rohs": {
              "type": "object",
              "required": ["compliant"],
              "properties": {
                "compliant": {
                  "type": "boolean"
                },
                "exemptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "conflict_minerals": {
              "type": "object",
              "required": ["compliant"],
              "properties": {
                "compliant": {
                  "type": "boolean"
                },
                "source": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "export_control": {
              "type": "object",
              "properties": {
                "classification": {
                  "type": "string",
                  "enum": ["EAR99", "ITAR", "DUAL_USE", "NONE"]
                },
                "authority": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        },
        "cryptographic": {
          "type": "object",
          "required": ["hash", "signature"],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA-256 hash of passport content"
            },
            "signature": {
              "type": "string",
              "description": "Digital signature by issuing authority"
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Hash of previous version (blockchain-style linking)"
            },
            "utcs_bundle": {
              "type": "string",
              "format": "uri",
              "description": "Reference to UTCS bundle"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["created", "updated"],
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "issuer": {
          "type": "string"
        }
      }
    }
  }
}
