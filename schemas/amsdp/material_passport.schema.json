{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideale-eu.org/schemas/amsdp/material_passport.schema.json",
  "title": "Material Passport Schema",
  "description": "Digital passport for aerospace materials and components",
  "type": "object",
  "required": ["passport", "version"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version (semantic versioning)"
    },
    "passport": {
      "type": "object",
      "required": ["id", "type", "classification", "identity", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AMSDP-MATERIAL-[A-Z0-9]+-v\\d+$",
          "description": "Unique passport identifier"
        },
        "type": {
          "type": "string",
          "enum": ["MATERIAL", "ASSEMBLY"],
          "description": "Passport type"
        },
        "classification": {
          "type": "string",
          "enum": ["PUBLIC", "RESTRICTED", "CONTROLLED"],
          "description": "Data classification level"
        },
        "identity": {
          "type": "object",
          "required": ["part_number", "serial_number", "manufacturer"],
          "properties": {
            "part_number": {
              "type": "string",
              "description": "Manufacturer part number"
            },
            "serial_number": {
              "type": "string",
              "description": "Unique serial number"
            },
            "manufacturer": {
              "type": "string",
              "description": "Manufacturer name"
            },
            "batch_lot": {
              "type": "string",
              "description": "Batch or lot number"
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["origin"],
          "properties": {
            "origin": {
              "type": "object",
              "required": ["country", "facility"],
              "properties": {
                "country": {
                  "type": "string",
                  "description": "Country of origin (ISO 3166-1 alpha-2)"
                },
                "facility": {
                  "type": "string",
                  "description": "Manufacturing facility"
                },
                "certification": {
                  "type": "string",
                  "description": "Facility certification"
                }
              }
            },
            "supply_chain": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["supplier", "date"],
                "properties": {
                  "supplier": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "certificate": {
                    "type": "string"
                  }
                }
              }
            },
            "certificates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "number", "issuer"],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "number": {
                    "type": "string"
                  },
                  "issuer": {
                    "type": "string"
                  },
                  "expiry": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "material_properties": {
          "type": "object",
          "properties": {
            "specification": {
              "type": "string",
              "description": "Material specification (e.g., AMS, ASTM)"
            },
            "composition": {
              "type": "object",
              "properties": {
                "elements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "percentages": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "mechanical": {
              "type": "object",
              "properties": {
                "tensile": {
                  "type": "number",
                  "description": "Tensile strength (MPa)"
                },
                "yield": {
                  "type": "number",
                  "description": "Yield strength (MPa)"
                },
                "hardness": {
                  "type": "string",
                  "description": "Hardness value and scale"
                }
              }
            },
            "environmental": {
              "type": "object",
              "properties": {
                "temp_min": {
                  "type": "number",
                  "description": "Minimum operating temperature (°C)"
                },
                "temp_max": {
                  "type": "number",
                  "description": "Maximum operating temperature (°C)"
                },
                "corrosion": {
                  "type": "string",
                  "description": "Corrosion resistance rating"
                }
              }
            }
          }
        },
        "quality_records": {
          "type": "object",
          "properties": {
            "inspection_reports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date", "inspector", "result"],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "inspector": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": ["PASS", "FAIL", "CONDITIONAL"]
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            },
            "test_results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "date", "pass_fail"],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "values": {
                    "type": "object"
                  },
                  "pass_fail": {
                    "type": "string",
                    "enum": ["PASS", "FAIL"]
                  }
                }
              }
            },
            "certifications": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["standard", "number", "date", "issuer"],
                "properties": {
                  "standard": {
                    "type": "string"
                  },
                  "number": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "issuer": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "manufactured": {
              "type": "object",
              "required": ["date", "facility"],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "facility": {
                  "type": "string"
                },
                "operator": {
                  "type": "string"
                }
              }
            },
            "received": {
              "type": "object",
              "required": ["date", "inspector", "condition"],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "inspector": {
                  "type": "string"
                },
                "condition": {
                  "type": "string",
                  "enum": ["ACCEPTABLE", "DAMAGED", "REJECTED"]
                }
              }
            },
            "installed": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "location": {
                  "type": "string"
                },
                "technician": {
                  "type": "string"
                },
                "asset_id": {
                  "type": "string",
                  "description": "Reference to AAMMPP asset"
                }
              }
            },
            "maintenance": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date", "type", "technician"],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "type": {
                    "type": "string"
                  },
                  "technician": {
                    "type": "string"
                  },
                  "findings": {
                    "type": "string"
                  },
                  "actions": {
                    "type": "string"
                  }
                }
              }
            },
            "removed": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "technician": {
                  "type": "string"
                }
              }
            },
            "disposition": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "method": {
                  "type": "string",
                  "enum": ["RECYCLED", "DISPOSED", "RETURNED", "SCRAPPED"]
                },
                "documentation": {
                  "type": "string"
                }
              }
            }
          }
        },
        "compliance": {
          "type": "object",
          "properties": {
            "reach": {
              "type": "object",
              "required": ["compliant"],
              "properties": {
                "compliant": {
                  "type": "boolean"
                },
                "substances": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "rohs": {
              "type": "object",
              "required": ["compliant"],
              "properties": {
                "compliant": {
                  "type": "boolean"
                },
                "exemptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "conflict_minerals": {
              "type": "object",
              "required": ["compliant"],
              "properties": {
                "compliant": {
                  "type": "boolean"
                },
                "source": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "export_control": {
              "type": "object",
              "properties": {
                "classification": {
                  "type": "string",
                  "enum": ["EAR99", "ITAR", "DUAL_USE", "NONE"]
                },
                "authority": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        },
        "cryptographic": {
          "type": "object",
          "required": ["hash", "signature"],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "SHA-256 hash of passport content"
            },
            "signature": {
              "type": "string",
              "description": "Digital signature by issuing authority"
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Hash of previous version (blockchain-style linking)"
            },
            "utcs_bundle": {
              "type": "string",
              "format": "uri",
              "description": "Reference to UTCS bundle"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["created", "updated"],
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "issuer": {
          "type": "string"
        }
      }
    }
  }
}
